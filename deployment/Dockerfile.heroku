FROM node:24-alpine3.24 AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY doorbell-backend/package.json doorbell-backend/package.json
COPY doorbell-frontend/package.json doorbell-frontend/package.json
RUN npm ci

COPY doorbell-backend doorbell-backend
COPY doorbell-frontend doorbell-frontend
RUN npm run build --workspace=doorbell-backend
RUN npm run build --workspace=doorbell-frontend

RUN npm ci --omit=dev --workspace=doorbell-backend --include-workspace-root=false

FROM node:24-alpine3.24

RUN apk add --no-cache curl nginx && mkdir -p /etc/nginx/templates

WORKDIR /app

COPY --from=build /app/doorbell-backend/dist doorbell-backend/dist
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/doorbell-backend/node_modules doorbell-backend/node_modules
COPY --from=build /app/package.json package.json
COPY --from=build /app/doorbell-backend/package.json doorbell-backend/package.json
COPY --from=build /app/doorbell-frontend/dist /usr/share/nginx/html
COPY deployment/nginx.heroku.conf /etc/nginx/templates/default.conf.template
COPY deployment/start-heroku.sh /usr/local/bin/start-heroku.sh

RUN chmod +x /usr/local/bin/start-heroku.sh

CMD ["/usr/local/bin/start-heroku.sh"]
